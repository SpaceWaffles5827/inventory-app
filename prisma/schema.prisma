// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// User model for authentication
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  passwordResetToken String?  @map("password_reset_token")
  passwordResetExpires DateTime? @map("password_reset_expires")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ADD THESE TWO FIELDS for 2FA
  two_factor_enabled Boolean @default(false)
  two_factor_code    String?

  // Relations
  workspaceMembers  WorkspaceMember[]
  stockTransactions StockTransaction[]
  itemImages        ItemImage[]
  lots              Lot[]

  @@map("users")
}

model AuthEvent {
  id           String   @id @default(cuid())
  occurredAt   DateTime @default(now()) @map("occurred_at")
  eventType    String   @map("event_type")
  outcome      String?  // "success", "failure", etc.
  userId       String?  @map("user_id")
  sessionRef   Bytes?   @map("session_ref") @db.VarBinary(32)
  ip           Bytes?   @db.VarBinary(16) // Stores INET6_ATON result
  uaHash       Bytes?   @map("ua_hash") @db.Binary(16)
  reasonCode   String?  @map("reason_code")
  requestId    String?  @map("request_id")
  details      Json?
  ipVersion    Int?     @map("ip_version")
  ip4Prefix24  Bytes?   @map("ip4_prefix24") @db.VarBinary(3)

  @@index([userId])
  @@index([eventType])
  @@index([occurredAt])
  @@index([outcome])
  @@map("auth_event")
}

// Workspace model (replaces Company)
model Workspace {
  id          String   @id @default(cuid())
  name        String
  description String?
  defaultLocationStructure Json @default("{\"levels\":[{\"label\":\"Zone\"},{\"label\":\"Aisle\"},{\"label\":\"Shelf\"},{\"label\":\"Bin\"}]}") @map("default_location_structure")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  members       WorkspaceMember[]
  invitations   Invitation[]
  items         Item[]
  categories    Category[]
  locations     Location[]
  suppliers     Supplier[]
  customers     Customer[]
  transactions  StockTransaction[]
  lots          Lot[]
  subscription  Subscription?

  @@map("workspaces")
}

// Junction table for users in workspaces
model WorkspaceMember {
  id        String   @id @default(cuid())
  role      Role     @default(MEMBER)
  joinedAt  DateTime @default(now())
  lastActive DateTime @default(now())

  // Foreign keys
  userId      String
  workspaceId String

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@map("workspace_members")
}

// Invitation model for pending workspace invites
model Invitation {
  id        String   @id @default(cuid())
  email     String
  role      Role     @default(MEMBER)
  status    InvitationStatus @default(PENDING)
  createdAt DateTime @default(now())
  expiresAt DateTime

  // Foreign keys
  workspaceId String

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("invitations")
}

// Category model for item categorization
model Category {
  id          String   @id @default(cuid())
  name        String
  description String?
  itemCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Foreign keys
  workspaceId String

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items     Item[]

  @@map("categories")
}

// Location model for warehouse storage locations
model Location {
  id          String   @id @default(cuid())
  code        String   // e.g., "A-01-01-A" or "NORTH-3-205" or "BLDG1-FL2-RM305"
  barcode     String?  // NEW: Barcode for location scanning
  structure   Json     // Flexible structure: [{ label: "Zone", value: "A" }, { label: "Aisle", value: "01" }]
  capacity    Int      @default(100)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Foreign keys
  workspaceId String

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items     ItemLocation[]
  lots      LotLocation[]

  @@unique([workspaceId, code])
  @@unique([workspaceId, barcode])
  @@map("locations")
}

// Supplier model
model Supplier {
  id            String   @id @default(cuid())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Foreign keys
  workspaceId String

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items     Item[]
  lots      Lot[]

  @@map("suppliers")
}

// Customer model
model Customer {
  id            String   @id @default(cuid())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  company       String?
  orderCount    Int      @default(0)
  totalSpent    Float    @default(0)
  status        CustomerStatus @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Foreign keys
  workspaceId String

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items     ItemCustomer[]

  @@map("customers")
}

// Junction table for items and customers (many-to-many)
model ItemCustomer {
  id          String   @id @default(cuid())
  quantity    Int      @default(0)
  lastOrderDate DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Foreign keys
  itemId      String
  customerId  String

  // Relations
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([itemId, customerId])
  @@map("item_customers")
}

// Junction table for items and locations (many-to-many)
// NOTE: quantity is DERIVED/CACHED from SUM(LotLocation.quantity) - NOT authoritative
model ItemLocation {
  id          String   @id @default(cuid())
  quantity    Int      @default(0)  // CACHED: Derived from SUM(lot.locations.quantity) for this item+location
  minStock    Int      @default(0)  // Minimum stock level for this location
  maxStock    Int      @default(0)  // Maximum stock level for this location
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Foreign keys
  itemId      String
  locationId  String

  // Relations
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location  Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([itemId, locationId])
  @@map("item_locations")
}

// Add CustomerStatus enum
enum CustomerStatus {
  ACTIVE
  INACTIVE
}

// Item model for inventory items
model Item {
  id          String   @id @default(cuid())
  itemNumber  String   // e.g., "ITM-001"
  name        String
  barcode     String?  // Optional barcode
  unit        String?  // Unit of measurement (e.g., "EA", "BOX", "KG", "LB")
  description String?  @db.Text
  cost        Float    @default(0)
  status      ItemStatus @default(IN_STOCK)
  lotTracking Boolean  @default(false) // Enable lot/batch tracking for this item
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Foreign keys
  workspaceId String
  categoryId  String?
  supplierId  String?

  // Relations
  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category      Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplier      Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  customers     ItemCustomer[]
  locations     ItemLocation[]
  transactions  StockTransaction[]
  images        ItemImage[]
  lots          Lot[]              // Different batches/lots of this same item

  @@unique([workspaceId, itemNumber])
  @@map("items")
}

// Lot model - represents a specific batch of the same item
// NOTE: quantity is DERIVED/CACHED from SUM(LotLocation.quantity) - NOT authoritative
model Lot {
  id              String      @id @default(cuid())
  lotNumber       String      // e.g., "LOT-2024-001", "BATCH-ABC123", or "SYSTEM" for non-lotted items
  quantity        Int         @default(0) // CACHED: Derived from SUM(locations.quantity)
  initialQuantity Int         // Original quantity received
  receivedDate    DateTime    @default(now()) // When this lot was received
  manufactureDate DateTime?   // When this lot was manufactured
  expirationDate  DateTime?   // When this lot expires
  status          LotStatus   @default(ACTIVE)
  poNumber        String?     // Purchase order number
  notes           String?     @db.Text
  isSystem        Boolean     @default(false) // TRUE for auto-created SYSTEM lots (non-lotted items)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Foreign keys
  itemId      String   // The item this lot belongs to
  workspaceId String
  supplierId  String?  // Which supplier this lot came from
  createdBy   String   // User who created/received this lot

  // Relations
  item        Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  supplier    Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  creator     User              @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  locations   LotLocation[]     // Where this lot is stored (can be multiple locations) - SOURCE OF TRUTH
  transactions StockTransaction[]

  @@unique([workspaceId, itemId, lotNumber])
  @@index([expirationDate])
  @@index([status])
  @@index([itemId])
  @@index([lotNumber]) // For quick SYSTEM lot lookups
  @@map("lots")
}

// Junction table for lots and locations - tracks where each lot is stored
// THIS IS THE SOURCE OF TRUTH FOR ALL INVENTORY QUANTITIES
model LotLocation {
  id          String   @id @default(cuid())
  quantity    Int      @default(0)  // SOURCE OF TRUTH: Actual units of this lot at this location
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Foreign keys
  lotId       String
  locationId  String

  // Relations
  lot         Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([lotId, locationId])
  @@index([lotId])
  @@index([locationId])
  @@map("lot_locations")
}

// Item image model for product photos
model ItemImage {
  id          String   @id @default(cuid())
  itemId      String
  imageName   String
  isPrimary   Boolean  @default(false)
  displayOrder Int     @default(0)
  uploadedAt  DateTime @default(now())
  uploadedBy  String

  // Relations
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [uploadedBy], references: [id], onDelete: NoAction)

  @@index([itemId, displayOrder])
  @@index([itemId, isPrimary])
  @@index([uploadedBy])
  @@map("item_images")
}

// Stock transaction model for audit trail
model StockTransaction {
  id            String            @id @default(cuid())
  type          TransactionType   // INPUT or OUTPUT
  quantity      Int
  previousStock Int
  newStock      Int
  reason        String
  lotId         String            // REQUIRED: Always references a lot (SYSTEM lot for non-lotted items)
  createdAt     DateTime          @default(now())

  // Foreign keys
  itemId      String
  workspaceId String
  userId      String

  // Relations
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lot       Lot       @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([lotId])
  @@index([itemId])
  @@map("stock_transactions")
}

// Subscription model for workspace billing
model Subscription {
  id              String           @id @default(cuid())
  plan            SubscriptionPlan @default(STARTER)
  status          SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean       @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Foreign keys
  workspaceId String @unique

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// Enums
enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum ItemStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum TransactionType {
  INPUT
  OUTPUT
}

enum SubscriptionPlan {
  STARTER
  PROFESSIONAL
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
}

enum LotStatus {
  ACTIVE       // Lot is available for use
  DEPLETED     // Lot quantity is 0
  EXPIRED      // Lot has passed expiration date
  QUARANTINED  // Lot is on hold/inspection
  RECALLED     // Lot has been recalled
}