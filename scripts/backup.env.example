# inventory-app backup config — copy to scripts/backup.env and edit.
# scripts/backup.env is gitignored. Everything here is OPTIONAL; the defaults
# target the PROD stack (compose project inventory-prod) out of the box.

# ── Compose invocation ──────────────────────────────────────────────────────
# Default (prod):
#   DC="docker compose -p inventory-prod -f docker-compose.yml --env-file .env"
# For the local DEV stack, uncomment:
# DC="docker compose -p inventory-app-dev -f docker-compose.dev.yml --env-file .dev.env"

# ── Where backups go ────────────────────────────────────────────────────────
# Defaults to <repo>/backups (same disk as the app — fine for accidental
# deletes, NOT for disk failure). Point at a separate disk/mount for safety:
# BACKUP_DIR=/var/backups/inventory-app

# ── Retention / rollover ────────────────────────────────────────────────────
# Keep the newest MIN_KEEP runs always; delete older ones past RETENTION_DAYS.
# RETENTION_DAYS=14
# MIN_KEEP=7

# ── Off-site copy (strongly recommended) ────────────────────────────────────
# Runs after each successful backup; "$1" is the new backup folder. This is the
# part that actually protects you if the whole server dies. Examples:
# OFFSITE_CMD='rsync -a "$1" backups@nas:/inventory-app/'
# OFFSITE_CMD='rclone copy "$1" r2:inventory-app-backups/$(basename "$1")'
