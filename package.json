{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .dev.env -- run-s stack:up db:wait prisma:sync && dotenv -e .dev.env -- run-p dev:front dev:back",
    "stack:up": "docker compose --env-file .dev.env -f docker-compose.dev.yml -p inventory-app-dev up -d",
    "db:wait": "dotenv -e .dev.env -- node -e \"require('wait-on')({ resources: ['tcp:127.0.0.1:' + process.env.MYSQL_PORT], timeout: 90000 }).then(()=>process.exit(0)).catch(()=>process.exit(1))\"",
    "dev:front": "dotenv -e .dev.env -- node -e \"const { spawnSync } = require('child_process'); const p = process.env.APP_INTERNAL_PORT || '3000'; const r = spawnSync('next', ['dev', '-p', p], { stdio: 'inherit', shell: true }); process.exit(r.status || 0);\"",
    "dev:back": "dotenv -e .dev.env -- node -e \"const { spawn } = require('child_process'); const p = process.env.SERVER_INTERNAL_PORT || '5001'; const cp = spawn('npx', ['nodemon', '--exec', 'tsx', './server/index.ts'], { stdio: 'inherit', shell: true, env: { ...process.env, PORT: p } }); cp.on('exit', c => process.exit(c));\"",
    "prisma:sync": "dotenv -e .dev.env -- node -e \"process.env.DATABASE_URL=process.env.DATABASE_URL_ROOT; const { spawnSync } = require('child_process'); const r = spawnSync('npx', ['prisma','db','push','--schema','prisma/schema.prisma'], { stdio: 'inherit', shell: true }); process.exit(r.status || 0);\"",
    "prod": "docker compose --env-file .env -f docker-compose.yml -p storage-prod up -d",
    "server:build": "cd server && tsc",
    "server:start": "node server/dist/index.js",
    "prod:build": "docker compose --env-file .env -p nova-prod -f docker-compose.yml -f docker-compose.build.yml build --pull app server && docker compose --env-file .env -p nova-prod -f docker-compose.yml -f docker-compose.build.yml up -d",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit"
  },
