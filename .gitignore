# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*.local
.env*
.dev.env
.local.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
/logs

# db and minio stuff
/dev/

# MinIO runtime state (common local paths)
minio/data/
minio/config/
minio/.env
minio/certs/*.key
minio/certs/*.crt
minio/certs/CAs/
.mc/    

# MySql
mysql/data/
mysql/_data/
mysql/config/
mysql/.env

# Redis
redis/data/
redis/config/
redis/.env

# Prisma
.secrets
/generated/prisma

# Backups
/backups/