<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Server the sign-in screen starts with (set per configuration in build settings). -->
	<key>StockFlowDefaultServerURL</key>
	<string>$(STOCKFLOW_DEFAULT_SERVER_URL)</string>

	<!-- Self-hosted StockFlow servers often run on plain http inside a LAN. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>StockFlow connects to your inventory server on the local network.</string>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchMark</string>
	</dict>

	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.stockflow.ios</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>stockflow</string>
			</array>
		</dict>
	</array>

	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.stockflow.scan</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Scan</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>Look up an item or location</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>barcode.viewfinder</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.stockflow.receive</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Receive Stock</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>tray.and.arrow.down</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.stockflow.newItem</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>New Item</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>plus.square</string>
		</dict>
	</array>
</dict>
</plist>
