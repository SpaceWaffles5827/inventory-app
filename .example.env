# StockFlow environment template.
# Copy to .dev.env for local development (and to .test.env with different ports for e2e tests).
# Replace every "change-me" value. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

TRAEFIK_HTTP_PORT=3069
TRAEFIK_DASHBOARD_PORT=8082

APP_INTERNAL_PORT=3000
SERVER_INTERNAL_PORT=5001

MYSQL_PORT=3308
REDIS_PORT=6382

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9003


########################################
# == Disaster Recovery (DR MinIO) ==
########################################
DR_ENDPOINT=http://backup-host:9000
DR_MINIO_ROOT_USER=minioadmin
DR_MINIO_ROOT_PASSWORD=change-me
DR_BUCKET_NAME=inventory-app

# 1 = allow plain HTTP for mc (only if DR endpoint is http)
MC_INSECURE=1


########################################
# == MySQL ==
########################################
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=inventory_software_dev
MYSQL_USER=appuser
MYSQL_PASSWORD=change-me
MYSQL_ROOT_HOST=%

# When running tools from host, use localhost + published port.
# In containers, service DNS is "mysql" and port 3306.
MYSQL_HOST=localhost

# Prisma URLs (parameterized ports/hosts)
DATABASE_URL=mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}
DATABASE_URL_ROOT=mysql://root:${MYSQL_ROOT_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}
SHADOW_DATABASE_URL=mysql://root:${MYSQL_ROOT_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/inventory_software_dev_shadow


########################################
# == Redis ==
########################################
# For host tooling use 127.0.0.1 + published port; 
# in containers use host "redis" and port 6379.
REDIS_HOST=127.0.0.1


########################################
# == MinIO (Local) ==
########################################
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
BUCKET_NAME=inventory-app
BUCKET_REGION=us-east-1

# Service URL for SDKs that expect S3-style endpoint
MINIO_ENDPOINT=http://localhost:${MINIO_API_PORT}


########################################
# == App Misc ==
########################################
DEV_MODE=true
SESSION_SECRET=change-me
USER_ID_ADMIN_MYSQL=
NEXT_PUBLIC_APP_VERSION=0.0.0

# App URLs
NEXT_PUBLIC_API_URL=http://localhost:${SERVER_INTERNAL_PORT}
NEXT_PUBLIC_APP_URL=http://localhost:${APP_INTERNAL_PORT}
BACKEND_ORIGIN=http://localhost:${SERVER_INTERNAL_PORT}
APP_URL_IOS=https://apps.apple.com/us/app/inventory-app/id0000000000


########################################
# == Email ==
########################################
DONOTREPLY_EMAIL=you@example.com
GOOGLE_EMAIL_USER=you@example.com
GOOGLE_APP_PASSWORD=change-me
# Production only
# COOKIE_SECURE=true
# CORS_ORIGINS=https://app.example.com
